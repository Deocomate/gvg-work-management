# Sao chép thành .env rồi sửa. KHÔNG đưa .env lên GitHub.
NODE_ENV=development
PORT=3000
APP_NAME=Lịch công việc
APP_TIMEZONE=Asia/Ho_Chi_Minh
APP_LOCALE=vi-VN
SESSION_SECRET=thay-bang-chuoi-ngau-nhien-dai

# Tài khoản admin được tạo tự động lúc khởi động (nếu chưa có)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=doi-mat-khau-nay
# Cho phép người dùng tự đăng ký (true/false)
ALLOW_SIGNUP=false

# Khi deploy host free (Render) dùng Turso để dữ liệu không mất:
# DATABASE_URL=libsql://ten-db.turso.io
# DATABASE_AUTH_TOKEN=...
