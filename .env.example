# Sao chép thành .env rồi sửa. KHÔNG đưa .env lên GitHub.
NODE_ENV=development
PORT=3000
APP_NAME=Work Calendar
APP_TIMEZONE=Asia/Ho_Chi_Minh
APP_LOCALE=vi-VN
SESSION_SECRET=thay-bang-chuoi-ngau-nhien-dai

# Tài khoản admin được tạo tự động lúc khởi động (nếu chưa có)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=doi-mat-khau-nay
# Cho phép người dùng tự đăng ký (true/false)
ALLOW_SIGNUP=false

# Khi deploy host free (Render) dùng Turso để dữ liệu không mất:
# DATABASE_URL=libsql://ten-db.turso.io
# DATABASE_AUTH_TOKEN=...

# Quảng cáo (trang /ads, chỉ quản lý xem)
# Số phút giữ số liệu trước khi tự lấy lại (mặc định 15)
# ADS_CACHE_MINUTES=15
# Facebook/Instagram: token System User (Business Manager > Người dùng hệ thống, quyền ads_read)
# META_ACCESS_TOKEN=
# META_AD_ACCOUNT_IDS=1234567890,act_9876543210
# TikTok: token Marketing API từ TikTok for Business (quyền Reporting)
# TIKTOK_ACCESS_TOKEN=
# TIKTOK_ADVERTISER_IDS=7000000000000000000

# Chấm công & tính lương (trang /luong). Luôn bật, vào bằng tài khoản lịch công việc:
# Quản lý = chủ cửa hàng; nhân viên liên kết tài khoản lương ở Cài đặt > Nhân viên.
# Không bắt buộc: mật khẩu (>= 12 ký tự) cho đăng nhập riêng bằng tên "admin" trong khung Lương.
# PAYROLL_ADMIN_USERNAME=admin
# PAYROLL_ADMIN_PASSWORD=
# Không đặt thì suy ra từ SESSION_SECRET (khi đó không được đổi SESSION_SECRET).
# Chuỗi ngẫu nhiên >= 32 ký tự, GIỮ NGUYÊN sau khi dùng (tạo khoá khôi phục dữ liệu lương). Tạo bằng:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# PAYROLL_SESSION_SECRET=
# Nơi lưu dữ liệu lương (mặc định data/payroll.db)
# PAYROLL_DB_FILE=data/payroll.db
