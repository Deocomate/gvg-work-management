# Sao chép thành .env rồi sửa. KHÔNG đưa .env lên GitHub.
NODE_ENV=development
PORT=3000
APP_NAME=Work Calendar
APP_TIMEZONE=Asia/Ho_Chi_Minh
APP_LOCALE=vi-VN
SESSION_SECRET=thay-bang-chuoi-ngau-nhien-dai

# Tài khoản admin được tạo tự động lúc khởi động (nếu chưa có)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=doi-mat-khau-nay
# Cho phép người dùng tự đăng ký (true/false)
ALLOW_SIGNUP=false

# Khi deploy host free (Render) dùng Turso để dữ liệu không mất:
# DATABASE_URL=libsql://ten-db.turso.io
# DATABASE_AUTH_TOKEN=...

# Quảng cáo (trang /ads). Chỉ các email này xem được, cách nhau dấu phẩy.
# ADS_VIEWER_EMAILS=email-cua-ban@congty.vn,email-chi-mai@congty.vn
# Số phút giữ số liệu trước khi tự lấy lại (mặc định 15)
# ADS_CACHE_MINUTES=15
# Facebook/Instagram: token System User (Business Manager > Người dùng hệ thống, quyền ads_read)
# META_ACCESS_TOKEN=
# META_AD_ACCOUNT_IDS=1234567890,act_9876543210
# TikTok: token Marketing API từ TikTok for Business (quyền Reporting)
# TIKTOK_ACCESS_TOKEN=
# TIKTOK_ADVERTISER_IDS=7000000000000000000
