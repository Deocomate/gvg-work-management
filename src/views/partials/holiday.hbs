{{!-- Ngày lễ: nhãn nhỏ đếm ngược trên thanh menu (src/lib/holidays.js). --}}
{{#if holiday}}
  <span class="holiday-pill" role="note" title="{{holiday.message}}">
    <span aria-hidden="true">{{holiday.icons.[0]}}</span>
    <span>{{holiday.name}}{{#if holiday.tag.count}} · còn {{holiday.tag.count}} ngày{{/if}}</span>
  </span>
{{/if}}
