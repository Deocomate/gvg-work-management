<header class="border-b border-slate-200 bg-white">
  <div class="container-page flex h-14 items-center gap-2 sm:gap-6">
    <a href="/" class="flex shrink-0 items-center gap-2 font-semibold text-slate-900" aria-label="{{appName}}">
      <img src="/img/favicon.svg" alt="" class="h-6 w-6">
      {{!-- Trên điện thoại ẩn tên app để menu đủ chỗ --}}
      <span class="hidden sm:inline">{{appName}}</span>
    </a>

    <nav class="flex flex-1 items-center gap-1 overflow-x-auto" aria-label="Điều hướng chính">
      {{#if currentUser}}
        {{> nav-link href="/today" label="Hôm nay" count=todayUnfinished}}
        {{> nav-link href="/calendar" label="Lịch"}}
        {{#if (eq currentUser.role 'admin')}}{{> nav-link href="/staff" label="Nhân viên"}}{{/if}}
      {{/if}}
      {{!-- [vibe:nav-links] Thêm link module mới: {{> nav-link href="/tasks" label="Công việc"}} --}}
    </nav>

    {{> auth/nav-user}}
    {{!-- [vibe:nav-right] --}}
  </div>
</header>
