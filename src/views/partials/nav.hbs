<header class="app-header sticky z-40 border-line bg-surface/85 backdrop-blur">
  {{#if holiday}}
    {{!-- Đồ trang trí treo lủng lẳng dưới thanh menu trong dịp lễ --}}
    <span class="holiday-hang holiday-hang-left" aria-hidden="true">{{holiday.icons.[0]}}</span>
  {{/if}}
  {{> holiday}}
  <div class="container-page flex h-14 items-center gap-2 sm:gap-6">
    {{!-- Logo và cụm bên phải cùng giãn đều (sm:flex-1) để menu nằm chính giữa header --}}
    <div class="flex shrink-0 sm:flex-1">
      <a href="/" class="flex items-center gap-2 font-semibold text-ink" aria-label="{{appName}}">
        <img src="/img/logo.svg" alt="" class="h-8 w-8">
        {{!-- Trên điện thoại ẩn tên app để menu đủ chỗ --}}
        <span class="hidden sm:inline">{{appName}}</span>
      </a>
    </div>

    <nav class="flex flex-1 items-center gap-1 overflow-x-auto sm:flex-none" aria-label="Điều hướng chính">
      {{#if currentUser}}
        {{> nav-link href="/today" label="Hôm nay" count=todayUnfinished}}
        {{> nav-link href="/calendar" label="Tháng"}}
        {{#if (eq currentUser.role 'admin')}}
          {{> nav-link href="/performance" label="Hiệu suất"}}
          {{> nav-link href="/staff" label="Nhân viên"}}
          {{> nav-link href="/links" label="Tài liệu"}}
        {{/if}}
      {{/if}}
      {{!-- [vibe:nav-links] Thêm link module mới: {{> nav-link href="/tasks" label="Công việc"}} --}}
    </nav>

    <div class="flex shrink-0 items-center justify-end gap-2 sm:flex-1 sm:gap-6">
      <button type="button" class="btn-ghost btn-sm theme-toggle" data-theme-toggle aria-label="Đổi giao diện sáng/tối" title="Đổi giao diện sáng/tối">
        <svg class="icon-sun h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/>
        </svg>
        <svg class="icon-moon h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/>
        </svg>
      </button>
      {{> auth/nav-user}}
      {{!-- [vibe:nav-right] --}}
    </div>
  </div>
</header>
