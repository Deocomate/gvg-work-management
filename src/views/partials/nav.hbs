<header class="app-header sticky z-40">
  {{> holiday}}

  <div class="container-page flex h-14 items-center gap-2 sm:gap-6">
    {{!-- Logo và cụm bên phải cùng giãn đều (sm:flex-1) để menu nằm chính giữa header --}}
    <div class="flex shrink-0 sm:flex-1">
      <a href="/" class="flex items-center gap-2 font-semibold text-ink" aria-label="{{appName}}">
        <img src="/img/logo.svg" alt="" class="h-8 w-8 max-w-none shrink-0">
        {{!-- Màn nhỏ/vừa ẩn tên app để menu đủ chỗ --}}
        <span class="hidden whitespace-nowrap xl:inline">{{appName}}</span>
      </a>
    </div>

    {{!-- min-w-0 + sm:flex-initial: màn vừa (tablet) menu tự co lại và cuộn ngang, không đẩy tràn cả trang --}}
    <nav class="flex min-w-0 flex-1 items-center gap-1 overflow-x-auto [scrollbar-width:none] sm:flex-initial [&::-webkit-scrollbar]:hidden max-xl:[mask-image:linear-gradient(to_right,black_calc(100%-28px),transparent)] max-xl:pr-6" aria-label="Điều hướng chính">
      {{#if currentUser}}
        {{!-- Trang chính: lịch tuần + bảng chấm công (Tháng là chế độ xem liên quan) --}}
        {{> nav-link href="/today" label="Lịch làm việc" count=todayUnfinished}}
        {{> nav-link href="/calendar" label="Tháng"}}
        {{> nav-link href="/plan" label="Nội dung"}}
        {{> nav-link href="/links" label="Tài liệu"}}
        {{!-- Quảng cáo gồm 2 tab: Hiệu quả quảng cáo (quản lý) + Data khách hàng (quản lý + Sale). Sale vào thẳng Data khách hàng. --}}
        {{#if canViewAds}}
          {{> nav-link href="/ads" label="Quảng cáo" active=(isActive currentPath '/customers')}}
        {{else if (eq currentUser.role 'sale')}}
          {{> nav-link href="/customers" label="Quảng cáo"}}
        {{/if}}
        {{!-- Chấm công & tính lương: app riêng ở /luong, vào bằng chính tài khoản lịch công việc --}}
        {{> nav-link href="/luong" label="Lương"}}
      {{/if}}
      {{!-- [vibe:nav-links] Thêm link module mới: {{> nav-link href="/tasks" label="Công việc"}} --}}
    </nav>

    <div class="flex shrink-0 items-center justify-end gap-2 sm:flex-1 sm:gap-4">
      {{!-- Cài đặt: Tài khoản (mọi người) + Nhân viên, Hiệu suất (quản lý) --}}
      {{#if currentUser}}
        <a href="/account" class="btn-ghost btn-sm theme-toggle {{#if (or (isActive currentPath '/account') (isActive currentPath '/staff') (isActive currentPath '/performance'))}}nav-link-active{{/if}}" aria-label="Cài đặt" title="Cài đặt">
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/>
          </svg>
        </a>
      {{/if}}
      <button type="button" class="btn-ghost btn-sm theme-toggle" data-theme-toggle aria-label="Đổi giao diện sáng/tối" title="Đổi giao diện sáng/tối">
        <svg class="icon-sun h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/>
        </svg>
        <svg class="icon-moon h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/>
        </svg>
      </button>
      {{> auth/nav-user}}
      {{!-- [vibe:nav-right] --}}
    </div>
  </div>
</header>
