{{!-- Dùng: {{> empty-state title="Chưa có dữ liệu" text="..." actionHref="/tasks/new" actionLabel="Thêm mới"}} --}}
<div class="card card-body flex flex-col items-center py-12 text-center">
  <div class="mb-3 flex h-12 w-12 items-center justify-center rounded-full bg-pine-500/40 text-pine-200" aria-hidden="true">
    <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M20.25 7.5l-.625 10.632a2.25 2.25 0 01-2.247 2.118H6.622a2.25 2.25 0 01-2.247-2.118L3.75 7.5m6 4.125h4.5M3.375 7.5h17.25c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125z"/></svg>
  </div>
  <h2 class="text-base font-semibold text-ink">{{title}}</h2>
  {{#if text}}<p class="mt-1 max-w-sm text-sm text-ink-faint">{{text}}</p>{{/if}}
  {{#if actionHref}}<a href="{{actionHref}}" class="btn-primary mt-5">{{actionLabel}}</a>{{/if}}
</div>
