{{!-- Khung chấm công trên lịch (public/js/attendance.js). Chỉ hiện khi phần Lương đã bật.
      Dùng: {{> payroll-attendance mode="today" day=date}} hoặc mode="calendar"; class tuỳ chọn (mặc định mb-5).
      Các ô ngày cần thêm: <span data-att-day="YYYY-MM-DD" hidden></span> --}}
{{#if @root.payrollEnabled}}
  <div data-att-root data-mode="{{mode}}" data-selected="{{day}}" class="{{#if class}}{{class}}{{else}}mb-5{{/if}}" hidden></div>
  <script src="/js/attendance.js?v={{@root.assetVersion}}" defer></script>
{{/if}}
