{{!-- Khung "Tài liệu cần thiết" ở trang Hôm nay. Dùng: {{> links/quick-links links=links manager=manager}} --}}
{{#if (or links.length manager)}}
  <section class="card card-body mt-8">
    <div class="flex items-center justify-between gap-2">
      <h2 class="text-sm font-semibold text-ink">Tài liệu cần thiết</h2>
      {{#if manager}}<a href="/links" class="btn-ghost btn-sm">Quản lý</a>{{/if}}
    </div>
    {{#if links.length}}
      <ul class="mt-3 grid gap-2 sm:grid-cols-2">
        {{#each links}}
          <li>
            <a href="{{url}}" target="_blank" rel="noopener noreferrer" class="block rounded-lg border border-line px-3 py-2 transition hover:border-bloom-400/60 hover:bg-bloom-400/5">
              <span class="block text-sm font-medium text-bloom-300">{{title}} ↗</span>
              {{#if note}}<span class="block text-xs text-ink-faint">{{note}}</span>{{/if}}
            </a>
          </li>
        {{/each}}
      </ul>
    {{else}}
      <p class="mt-2 text-sm text-ink-faint">Chưa có link nào. <a href="/links/new" class="link">Thêm link đầu tiên</a> để cả nhóm mở nhanh tài liệu.</p>
    {{/if}}
  </section>
{{/if}}
