{{!-- Một việc trên dòng thời gian. Dùng: {{> schedule/task-item this back=../back showAssignee=../showAssignee showDate=false}} --}}
<li class="card flex gap-3 p-4 transition hover:border-line-strong sm:gap-4{{#if isNow}} ring-2 ring-bloom-400/70{{/if}}">
  <div class="w-14 shrink-0 pt-0.5 text-right text-sm tabular-nums sm:w-16">
    {{#if start_time}}
      <div class="font-semibold text-ink">{{start_time}}</div>
      {{#if end_time}}<div class="text-xs text-ink-faint">{{end_time}}</div>{{/if}}
    {{else}}
      <div class="text-xs font-medium text-ink-faint">Cả ngày</div>
    {{/if}}
  </div>

  <div class="min-w-0 flex-1 border-l-4 pl-3 sm:pl-4 {{statusInfo.bar}}">
    <div class="flex flex-wrap items-center gap-2">
      <h3 class="font-medium {{#if (eq status 'done')}}text-ink-faint line-through{{else}}text-ink{{/if}}">{{title}}</h3>
      <span class="{{statusInfo.badge}}">{{statusInfo.label}}</span>
      {{#if isHigh}}<span class="badge-red">Quan trọng</span>{{/if}}
      {{#if isNow}}<span class="badge-pink">Đang diễn ra</span>{{/if}}
      {{#if isLate}}<span class="badge-red">Trễ</span>{{/if}}
    </div>
    {{#if showDate}}<p class="mt-0.5 text-xs text-ink-faint">{{formatWeekday date}}</p>{{/if}}
    {{#if showAssignee}}<p class="mt-0.5 text-xs text-ink-faint">Người làm: <span class="font-medium text-ink-soft">{{assignee_name}}</span></p>{{/if}}
    {{#if note}}<p class="mt-1.5 text-sm whitespace-pre-line text-ink-soft">{{note}}</p>{{/if}}
    {{#if linkList.length}}
      <ul class="mt-2 flex flex-wrap gap-2" aria-label="Link liên quan">
        {{#each linkList}}
          <li class="min-w-0 max-w-full">
            <a href="{{url}}" target="_blank" rel="noopener noreferrer" title="{{url}}"
               class="block truncate rounded-lg border border-line px-2.5 py-1 text-xs font-medium text-bloom-300 transition hover:border-bloom-400/60 hover:bg-bloom-400/5">🔗 {{label}} ↗</a>
          </li>
        {{/each}}
      </ul>
    {{/if}}

    {{#if (or canStatus canEdit)}}
      <div class="mt-3 flex flex-wrap items-center gap-2">
        {{#if canStatus}}
          {{#if (eq status 'todo')}}
            {{> schedule/status-button id=id status="doing" label="Bắt đầu" class="btn-secondary btn-sm" back=back}}
            {{> schedule/status-button id=id status="done" label="✓ Xong" class="btn-primary btn-sm" back=back}}
          {{else if (eq status 'doing')}}
            {{> schedule/status-button id=id status="done" label="✓ Xong" class="btn-primary btn-sm" back=back}}
          {{else}}
            {{> schedule/status-button id=id status="todo" label="Mở lại" class="btn-ghost btn-sm" back=back}}
          {{/if}}
        {{/if}}
        {{#if canEdit}}<a href="/tasks/{{id}}/edit?back={{urlEncode back}}" class="btn-ghost btn-sm">Sửa</a>{{/if}}
      </div>
    {{/if}}
  </div>
</li>
