{{!-- Nút đổi nhanh trạng thái. Dùng: {{> plan/status-button id=id status="posted" label="✅ Đã đăng"}} --}}
<form method="post" action="/plan/{{id}}/status" class="inline">
  {{> form/csrf}}
  <input type="hidden" name="status" value="{{status}}">
  <input type="hidden" name="back" value="{{@root.back}}">
  <button type="submit" class="btn-ghost btn-sm">{{label}}</button>
</form>
