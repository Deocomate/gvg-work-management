{{!-- Hai tab con của Plan. Dùng: {{> plan/tabs}} (biến tab = 'ideas' | 'calendar') --}}
<div class="segmented mb-5 max-w-md" role="tablist" aria-label="Plan nội dung">
  <a href="/plan" role="tab" class="plan-tab {{#if (eq @root.tab 'ideas')}}plan-tab-active{{/if}}"{{#if (eq @root.tab 'ideas')}} aria-selected="true"{{/if}}>💡 Idea bank</a>
  <a href="/plan/calendar" role="tab" class="plan-tab {{#if (eq @root.tab 'calendar')}}plan-tab-active{{/if}}"{{#if (eq @root.tab 'calendar')}} aria-selected="true"{{/if}}>📅 Lịch quay / đăng</a>
</div>
