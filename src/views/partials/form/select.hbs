{{!-- Dùng: {{> form/select name="status" label="Trạng thái" options=statusOptions value=values.status error=errors.status}}
     options là mảng [{ value: 'todo', label: 'Cần làm' }, ...]. public/js/pickers.js vẽ thành danh sách xổ xuống.
     Chỉ 2–4 lựa chọn ngắn? Dùng form/segmented cho nhanh hơn (bấm một lần). --}}
<div class="field">
  <label for="f-{{name}}" class="label">{{label}}{{#if required}} <span class="required-mark" aria-hidden="true">*</span>{{/if}}</label>
  <select id="f-{{name}}" name="{{name}}" class="input{{#if error}} input-error{{/if}}" {{#if required}}required{{/if}}
    {{#if error}}aria-invalid="true" aria-describedby="f-{{name}}-error"{{/if}}>
    {{#if placeholder}}<option value="">{{placeholder}}</option>{{/if}}
    {{#each options}}
      <option value="{{this.value}}" {{selected this.value ../value}}>{{this.label}}</option>
    {{/each}}
  </select>
  {{#if hint}}<p class="hint">{{hint}}</p>{{/if}}
  {{#if error}}<p id="f-{{name}}-error" class="field-error">{{error}}</p>{{/if}}
</div>
