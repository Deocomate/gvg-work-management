{{!-- Dùng: {{> form/field name="title" label="Tiêu đề" value=values.title error=errors.title required=true}}
     Tham số khác: type (text|email|number|date|time|password...), placeholder, hint, autofocus
     Ô ngày/giờ được public/js/pickers.js vẽ lại: minFrom="date" (không chọn trước ngày ở ô date),
     after="start_time" (giờ kết thúc tự theo giờ bắt đầu), clearLabel="Cả ngày" (chữ nút bỏ chọn) --}}
<div class="field">
  <label for="f-{{name}}" class="label">{{label}}{{#if required}} <span class="required-mark" aria-hidden="true">*</span>{{/if}}</label>
  <input id="f-{{name}}" name="{{name}}" type="{{default type 'text'}}" value="{{value}}"
    class="input{{#if error}} input-error{{/if}}"
    {{#if required}}required{{/if}}
    {{#if autofocus}}autofocus{{/if}}
    {{#if placeholder}}placeholder="{{placeholder}}"{{/if}}
    {{#if minFrom}}data-min-from="{{minFrom}}"{{/if}}
    {{#if after}}data-after="{{after}}"{{/if}}
    {{#if clearLabel}}data-clear-label="{{clearLabel}}"{{/if}}
    {{#if error}}aria-invalid="true" aria-describedby="f-{{name}}-error"{{/if}}>
  {{#if hint}}<p class="hint">{{hint}}</p>{{/if}}
  {{#if error}}<p id="f-{{name}}-error" class="field-error">{{error}}</p>{{/if}}
</div>
