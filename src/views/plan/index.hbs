{{#> page-header title="Plan nội dung" subtitle="Mỗi ý tưởng đi qua từng bước, từ ý tưởng tới bài đã đăng"}}
  <a href="/plan/new?back={{urlEncode back}}" class="btn-primary">+ Thêm ý tưởng</a>
{{/page-header}}

{{> plan/tabs}}

<form method="get" action="/plan" class="mb-4 flex flex-wrap items-end gap-2" role="search">
  {{#if dropped}}<input type="hidden" name="dropped" value="1">{{/if}}
  <input name="q" type="search" value="{{query}}" class="input w-full sm:w-64" placeholder="🔍 Tìm (gõ không dấu cũng được)" aria-label="Tìm ý tưởng">
  <select name="brand" class="input w-auto" aria-label="Brand" data-autosubmit>
    <option value="">Mọi brand</option>
    {{#each brandOptions}}<option value="{{value}}" {{selected value @root.brand}}>{{label}}</option>{{/each}}
  </select>
  <select name="topic" class="input w-auto max-w-56" aria-label="Tuyến nội dung" data-autosubmit>
    <option value="">Mọi tuyến nội dung</option>
    {{#each topics}}<option value="{{topic}}" {{selected topic @root.topic}}>{{topic}} ({{total}})</option>{{/each}}
  </select>
  <select name="owner" class="input w-auto" aria-label="Người làm" data-autosubmit>
    <option value="">Mọi người</option>
    {{#each ownerOptions}}<option value="{{value}}" {{selected value @root.owner}}>{{label}}</option>{{/each}}
  </select>
  <button type="submit" class="btn-secondary">Tìm</button>
  {{#if filtered}}<a href="/plan{{#if dropped}}?dropped=1{{/if}}" class="btn-ghost">Xoá lọc</a>{{/if}}
  <a href="/plan?{{#unless dropped}}dropped=1&{{/unless}}brand={{urlEncode brand}}&topic={{urlEncode topic}}&owner={{owner}}&q={{urlEncode query}}" class="btn-ghost btn-sm sm:ml-auto">
    {{#if dropped}}Ẩn cột “Bỏ”{{else}}Hiện cột “Bỏ” ({{droppedTotal}}){{/if}}
  </a>
</form>

{{#if total}}
  {{!-- Bảng cột theo bước: kéo ngang trên điện thoại --}}
  <div class="plan-board" data-plan-board>
    {{#each columns}}
      <section class="plan-col" data-plan-col="{{value}}" aria-label="{{label}}">
        <h2 class="plan-col-head">
          <span class="{{badge}}">{{label}}</span>
          <span class="text-xs text-ink-faint">{{total}}</span>
        </h2>
        <ul class="space-y-2">
          {{#each items}}
            <li class="plan-card" data-plan-row>
              {{#if canEdit}}
                <a href="/plan/{{id}}/edit?back={{urlEncode @root.back}}" class="plan-card-title hover:underline" title="{{title}}">{{title}}</a>
              {{else}}
                <p class="plan-card-title" title="{{title}}">{{title}}</p>
              {{/if}}
              <p class="mt-1.5 flex flex-wrap gap-1 text-[11px]">
                {{#if brand}}<span class="badge-pink">{{brand}}</span>{{/if}}
                {{#if video_type}}<span class="badge-gray">{{video_type}}</span>{{/if}}
                {{#if (ne platform 'tiktok')}}<span class="badge-gray">{{platformInfo.label}}</span>{{/if}}
              </p>
              {{#if topic}}<p class="mt-1 truncate text-xs text-ink-faint" title="{{topic}}">{{topic}}</p>{{/if}}
              <p class="mt-1.5 flex flex-wrap gap-x-3 gap-y-0.5 text-xs text-ink-soft">
                {{#if shoot_date}}<span>🎬 {{formatDay shoot_date}}</span>{{/if}}
                {{#if post_date}}<span>📤 {{formatDay post_date}}{{#if post_time}} {{post_time}}{{/if}}</span>{{/if}}
                {{#if owner_name}}<span>👤 {{owner_name}}</span>{{/if}}
                {{#if writer_name}}<span>✍ {{writer_name}}</span>{{/if}}
                {{#if (and (not owner_name) (not writer_name) proposer_name)}}<span>💡 {{proposer_name}}</span>{{/if}}
                {{#if reference_url}}{{#if (isUrl reference_url)}}<a href="{{reference_url}}" target="_blank" rel="noopener noreferrer" class="link font-normal">🔗 Tham khảo</a>{{/if}}{{/if}}
                {{#if script}}{{#if (isUrl script)}}<a href="{{script}}" target="_blank" rel="noopener noreferrer" class="link font-normal">📄 Kịch bản</a>{{/if}}{{/if}}
                {{#if post_url}}<a href="{{post_url}}" target="_blank" rel="noopener noreferrer" class="link font-normal">▶ Bài đăng</a>{{/if}}
              </p>
              {{#if (and canEdit nextStep)}}
                <div class="mt-2 border-t border-line pt-2">
                  {{#if nextStep.edit}}
                    <a href="/plan/{{id}}/edit?back={{urlEncode @root.back}}" class="btn-ghost btn-sm w-full justify-center">{{nextStep.label}}</a>
                  {{else}}
                    {{> plan/status-button id=id status=nextStep.status label=nextStep.label full=true}}
                  {{/if}}
                </div>
              {{/if}}
            </li>
          {{else}}
            <li class="rounded-lg border border-dashed border-line px-3 py-4 text-center text-xs text-ink-faint">Trống</li>
          {{/each}}
        </ul>
        {{#if more}}<p class="mt-2 text-center text-xs text-ink-faint">+{{more}} bài cũ hơn</p>{{/if}}
      </section>
    {{/each}}
  </div>
{{else if filtered}}
  {{> empty-state title="Không có ý tưởng nào khớp" text="Thử bỏ bớt bộ lọc hoặc gõ từ khác ngắn hơn."}}
{{else}}
  {{> empty-state title="Kho ý tưởng đang trống" text="Ghi lại mọi ý tưởng video, bài đăng ở đây. Khi chọn được ngày quay/đăng, ý tưởng sẽ hiện trên lịch và lịch làm việc của người phụ trách." actionHref="/plan/new" actionLabel="+ Thêm ý tưởng"}}
{{/if}}

{{#if canImport}}
  <div class="card card-body mt-10 flex flex-col gap-3 sm:flex-row sm:items-center">
    <div class="min-w-0 flex-1">
      <p class="font-medium text-ink">Chuyển dữ liệu từ Google Sheet cũ</p>
      <p class="text-sm text-ink-faint">Nhập các dòng ở tab Plan và Idea bank của Sheet “Idea bank - Gốm Vũ Gia, Klayy &amp; GSXD”, việc quay/đăng tự lên lịch làm việc. Bấm lại cũng không bị trùng. Chỉ quản lý thấy nút này.</p>
    </div>
    <form method="post" action="/plan/import-sheet" data-confirm="Nhập dữ liệu từ Google Sheet cũ vào Plan?">
      {{> form/csrf}}
      <button type="submit" class="btn-secondary whitespace-nowrap">⬇ Nhập từ Sheet</button>
    </form>
  </div>
{{/if}}
