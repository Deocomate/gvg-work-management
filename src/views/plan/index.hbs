{{#> page-header title="Nội dung" subtitle="Ý tưởng mới và đã chọn. Bấm “Xong” thì nội dung chuyển vào Lưu trữ"}}
  <a href="/plan/new?back={{urlEncode back}}" class="btn-primary">+ Thêm ý tưởng</a>
{{/page-header}}

{{> plan/tabs}}

<form method="get" action="/plan" class="mb-4 flex flex-wrap items-end gap-2" role="search">
  {{#if dropped}}<input type="hidden" name="dropped" value="1">{{/if}}
  <input name="q" type="search" value="{{query}}" class="input w-full sm:w-64" placeholder="Tìm (gõ không dấu cũng được)" aria-label="Tìm ý tưởng">
  <select name="brand" class="input w-auto" aria-label="Brand" data-autosubmit>
    <option value="">Mọi brand</option>
    {{#each brandOptions}}<option value="{{value}}" {{selected value @root.brand}}>{{label}}</option>{{/each}}
  </select>
  <select name="owner" class="input w-auto" aria-label="Người làm" data-autosubmit>
    <option value="">Mọi người</option>
    {{#each ownerOptions}}<option value="{{value}}" {{selected value @root.owner}}>{{label}}</option>{{/each}}
  </select>
  <select name="link" class="input w-auto" aria-label="Link" data-autosubmit>
    <option value="">Mọi link</option>
    {{#each linkOptions}}<option value="{{value}}" {{selected value @root.link}}>{{label}}</option>{{/each}}
  </select>
  <button type="submit" class="btn-secondary">Tìm</button>
  {{#if filtered}}<a href="/plan{{#if dropped}}?dropped=1{{/if}}" class="btn-ghost">Xoá lọc</a>{{/if}}
  <a href="/plan?{{#unless dropped}}dropped=1&{{/unless}}brand={{urlEncode brand}}&owner={{owner}}&link={{link}}&q={{urlEncode query}}" class="btn-ghost btn-sm sm:ml-auto">
    {{#if dropped}}Ẩn cột “Bỏ”{{else}}Hiện cột “Bỏ” ({{droppedTotal}}){{/if}}
  </a>
</form>

{{#if total}}
  {{!-- Bảng cột theo bước: kéo ngang trên điện thoại --}}
  <div class="plan-board" data-plan-board>
    {{#each columns}}
      <section class="plan-col" data-plan-col="{{value}}" aria-label="{{label}}">
        <h2 class="plan-col-head">
          <span class="{{badge}}">{{label}}</span>
          <span class="text-xs text-ink-faint">{{total}}</span>
        </h2>
        {{#if groups.length}}
          {{!-- Đã chọn: chia theo tuần đăng --}}
          {{#each groups}}
            <div class="plan-group{{#if isPast}} opacity-70{{/if}}" data-plan-week>
              <h3 class="plan-group-head">
                <span class="{{#if isThisWeek}}text-ink{{/if}}">{{label}}{{#if isThisWeek}} · tuần này{{/if}}</span>
                <span class="tabular-nums">{{#if range}}{{range}} · {{/if}}{{items.length}}</span>
              </h3>
              <ul class="space-y-2">
                {{#each items}}{{> plan/card}}{{/each}}
              </ul>
            </div>
          {{/each}}
        {{else}}
          <ul class="space-y-2">
            {{#each items}}
              {{> plan/card}}
            {{else}}
              <li class="rounded-lg border border-dashed border-line px-3 py-4 text-center text-xs text-ink-faint">Trống</li>
            {{/each}}
          </ul>
        {{/if}}
      </section>
    {{/each}}
  </div>
{{else if filtered}}
  {{> empty-state title="Không có ý tưởng nào khớp" text="Thử bỏ bớt bộ lọc hoặc gõ từ khác ngắn hơn."}}
{{else}}
  {{> empty-state title="Kho ý tưởng đang trống" text="Ghi lại mọi ý tưởng video, bài đăng ở đây. Khi chọn được ngày quay/đăng, ý tưởng sẽ hiện trên lịch và lịch làm việc của người phụ trách." actionHref="/plan/new" actionLabel="+ Thêm ý tưởng"}}
{{/if}}

{{#if canImport}}
  <div class="card card-body mt-10 flex flex-col gap-3 sm:flex-row sm:items-center">
    <div class="min-w-0 flex-1">
      <p class="font-medium text-ink">Chuyển dữ liệu từ Google Sheet cũ</p>
      <p class="text-sm text-ink-faint">Nhập các dòng ở tab Plan và Idea bank của Sheet “Idea bank - Gốm Vũ Gia, Klayy &amp; GSXD”, việc quay/đăng tự lên lịch làm việc. Bấm lại cũng không bị trùng. Chỉ quản lý thấy nút này.</p>
    </div>
    <form method="post" action="/plan/import-sheet" data-confirm="Nhập dữ liệu từ Google Sheet cũ vào Plan?">
      {{> form/csrf}}
      <button type="submit" class="btn-secondary whitespace-nowrap">Nhập từ Sheet</button>
    </form>
  </div>
{{/if}}
