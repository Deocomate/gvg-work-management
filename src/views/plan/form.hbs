{{#> page-header title=title}}
  <a href="{{back}}" class="btn-secondary">← Quay lại</a>
{{/page-header}}

<form method="post" action="{{#if plan}}/plan/{{plan.id}}{{else}}/plan{{/if}}" class="card card-body max-w-3xl" novalidate>
  {{> form/csrf}}
  <input type="hidden" name="back" value="{{back}}">
  {{#if errors._form}}<div class="alert-error mb-5">{{errors._form}}</div>{{/if}}

  {{!-- Phần chính: đủ để ghi nhanh một ý tưởng --}}
  {{> form/field name="title" label="Nội dung / tên ý tưởng" value=values.title error=errors.title required=true autofocus=(not plan) placeholder="VD: Mở lò vẽ vàng"}}
  {{> form/textarea name="description" label="Mô tả kịch bản" value=values.description error=errors.description rows=3 placeholder="Tóm tắt kịch bản: hook, các cảnh chính, lời thoại…" hint="Hiện ngay trên Lịch đăng / Lịch quay để cả nhóm biết video quay gì."}}
  {{> form/field name="reference_url" label="Link tham khảo" value=values.reference_url error=errors.reference_url placeholder="https://www.tiktok.com/… — video mẫu, bài viết gợi ý (hoặc ghi tên video)"}}
  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    {{> form/field name="post_date" label="Ngày đăng" type="date" value=values.post_date error=errors.post_date clearLabel="Chưa chốt"}}
    {{> form/select name="brand" label="Brand" options=brandOptions value=values.brand error=errors.brand placeholder="Chưa chọn"}}
    {{> form/select name="owner_id" label="Người phụ trách" options=ownerOptions value=values.owner_id error=errors.owner_id placeholder="Chưa giao" hint="Việc quay / đăng tự lên lịch làm việc của người này."}}
    {{> form/select name="status" label="Bước hiện tại" options=statusOptions value=values.status error=errors.status hint="Có ngày quay/đăng thì tự thành “Đã lên lịch”."}}
  </div>

  {{!-- Các phần chi tiết: gập lại, tự mở khi đã có dữ liệu --}}
  <div class="mt-2 space-y-3">
    <details class="plan-fold"{{#if open.script}} open{{/if}}>
      <summary>Kịch bản <span>người viết, link kịch bản</span></summary>
      <div class="plan-fold-body grid gap-4 sm:grid-cols-[1fr_2fr]">
        {{> form/select name="writer_id" label="Người viết kịch bản" options=ownerOptions value=values.writer_id error=errors.writer_id placeholder="Chưa giao"}}
        {{> form/field name="script" label="Kịch bản" value=values.script error=errors.script placeholder="Link Google Docs, tên file, hoặc “Không cần”"}}
      </div>
    </details>

    <details class="plan-fold"{{#if open.shoot}} open{{/if}}>
      <summary>Lịch quay <span>ngày, khung giờ, địa điểm, CSVC</span></summary>
      <div class="plan-fold-body">
        <div class="grid gap-4 sm:grid-cols-3">
          {{> form/field name="shoot_date" label="Ngày quay" type="date" value=values.shoot_date error=errors.shoot_date clearLabel="Chưa chốt"}}
          {{> form/field name="shoot_time" label="Khung giờ quay" value=values.shoot_time error=errors.shoot_time placeholder="VD: 15h00 - 15h30"}}
          {{> form/field name="location" label="Địa điểm" value=values.location error=errors.location placeholder="VD: Xưởng, 18"}}
        </div>
        {{> form/field name="props" label="CSVC cần chuẩn bị" value=values.props error=errors.props placeholder="VD: Ban thần tài, đèn, chân máy"}}
      </div>
    </details>

  </div>

  <div class="mt-6 flex flex-wrap items-center gap-2 border-t border-line pt-5">
    <button type="submit" class="btn-primary">{{#if plan}}Lưu thay đổi{{else}}Thêm ý tưởng{{/if}}</button>
    <a href="{{back}}" class="btn-ghost">Huỷ</a>
  </div>
</form>

{{#if plan.id}}
  {{#if (or (eq @root.currentUser.role 'admin') (eq plan.created_by @root.currentUser.id))}}
    <form method="post" action="/plan/{{plan.id}}/delete" class="mt-4 max-w-3xl text-right" data-confirm="Xoá nội dung này? Việc quay/đăng trên lịch làm việc cũng bị xoá.">
      {{> form/csrf}}
      <button type="submit" class="btn-ghost btn-sm text-bad-300">Xoá nội dung này</button>
    </form>
  {{/if}}
{{/if}}
