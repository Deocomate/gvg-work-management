{{#> page-header title=text.title subtitle=text.subtitle}}
  <a href="/plan/new?back={{urlEncode back}}" class="btn-primary">+ Thêm nội dung</a>
{{/page-header}}

{{> plan/tabs}}

<div class="mb-5 flex flex-wrap items-center gap-2">
  <a href="/plan/calendar?kind={{kind}}{{#if brand}}&brand={{urlEncode brand}}{{/if}}&month={{prev}}" class="btn-secondary btn-sm">‹ Tháng trước</a>
  <h2 class="px-2 text-lg font-semibold text-ink">{{monthLabel}}</h2>
  <a href="/plan/calendar?kind={{kind}}{{#if brand}}&brand={{urlEncode brand}}{{/if}}&month={{next}}" class="btn-secondary btn-sm">Tháng sau ›</a>
  {{#if (ne month thisMonth)}}<a href="/plan/calendar?kind={{kind}}{{#if brand}}&brand={{urlEncode brand}}{{/if}}&month={{thisMonth}}" class="btn-ghost btn-sm">Tháng này</a>{{/if}}
  <p class="flex flex-wrap gap-2 text-xs sm:ml-auto">
    <span class="{{#if (eq kind 'shoot')}}badge-yellow{{else}}badge-blue{{/if}}">{{text.icon}} {{summary.total}} {{text.unit}}</span>
    <span class="badge-green">✅ {{summary.done}} {{text.done}}</span>
    {{#each summary.byBrand}}<span class="{{badge}}">{{label}}: {{total}}</span>{{/each}}
  </p>
</div>

<div class="card overflow-hidden">
  <div class="grid grid-cols-7 border-b border-line bg-raised text-center text-xs font-semibold text-ink-faint">
    {{#each weekdayLabels}}<div class="py-2">{{this}}</div>{{/each}}
  </div>
  {{#each weeks}}
    <div class="grid grid-cols-7 border-b border-line last:border-b-0">
      {{#each this}}
        <div class="min-h-16 min-w-0 border-r border-line p-1 last:border-r-0 sm:min-h-28 sm:p-2{{#unless inMonth}} bg-canvas/60 text-ink-faint{{/unless}}" data-plan-day="{{date}}">
          <div class="flex items-center justify-between gap-1">
            <span class="flex h-6 w-6 items-center justify-center rounded-full text-xs font-medium{{#if isToday}} bg-brand-500 text-cream{{/if}}">{{day}}</span>
            <a href="/plan/new?{{@root.text.dateParam}}={{date}}{{#if @root.brand}}&brand={{urlEncode @root.brand}}{{/if}}&back={{urlEncode @root.back}}" class="plan-day-add" title="Thêm nội dung ngày {{formatDay date}}" aria-label="Thêm nội dung ngày {{formatDay date}}">+</a>
          </div>
          {{#if total}}
            {{!-- Điện thoại: chỉ hiện số; máy tính: hiện từng nội dung kèm brand viết tắt --}}
            <p class="mt-1 text-center text-[11px] leading-tight sm:hidden">{{@root.text.icon}}{{total}}</p>
            <ul class="mt-1 hidden space-y-1 sm:block">
              {{#each entries}}
                <li>
                  <a href="{{#if canEdit}}/plan/{{id}}/edit?back={{urlEncode @root.back}}{{else}}/plan?q={{urlEncode title}}{{/if}}"
                     class="flex items-center gap-1 truncate rounded px-1.5 py-0.5 text-xs {{statusInfo.chip}}"
                     title="{{@root.text.verb}}: {{title}} — {{brandInfo.label}} · {{statusInfo.label}}{{#if description}} — {{description}}{{/if}}">
                    <span class="{{brandInfo.badge}} shrink-0 px-1 py-0 text-[10px]">{{brandInfo.short}}</span>
                    <span class="truncate">{{title}}</span>
                  </a>
                </li>
              {{/each}}
              {{#if more}}<li class="px-1.5 text-xs text-ink-faint">+{{more}} nội dung khác</li>{{/if}}
            </ul>
          {{/if}}
        </div>
      {{/each}}
    </div>
  {{/each}}
</div>

<p class="mt-3 flex flex-wrap gap-3 text-xs text-ink-faint">
  <span>Nhãn màu = brand (VG = Vũ Gia, KL = Klayy, GS = GSXD). Màu thẻ = bước hiện tại.</span>
</p>

{{#if agenda.length}}
  <h2 class="mt-8 mb-3 text-lg font-semibold text-ink">Chi tiết trong tháng</h2>
  <ul class="card divide-y divide-line" data-plan-agenda>
    {{#each agenda}}
      <li class="flex flex-col gap-2 px-4 py-3 sm:flex-row sm:gap-4{{#if isPast}} opacity-70{{/if}}">
        <p class="w-36 shrink-0 text-sm font-medium {{#if isToday}}text-brand-300{{else}}text-ink-soft{{/if}}">{{formatWeekday date}}</p>
        <ul class="min-w-0 flex-1 space-y-1.5">
          {{#each entries}}
            <li class="flex flex-wrap items-center gap-2 text-sm">
              <span class="{{brandInfo.badge}}">{{brandInfo.label}}</span>
              {{#if (eq kind 'shoot')}}{{#if shoot_time}}<span class="text-ink-faint">{{shoot_time}}</span>{{/if}}{{/if}}
              {{#if canEdit}}
                <a href="/plan/{{id}}/edit?back={{urlEncode @root.back}}" class="min-w-0 truncate font-medium text-ink hover:underline">{{title}}</a>
              {{else}}
                <span class="min-w-0 truncate font-medium text-ink">{{title}}</span>
              {{/if}}
              <span class="{{statusInfo.badge}}">{{statusInfo.label}}</span>
              {{#if (and (eq kind 'shoot') location)}}<span class="text-xs text-ink-faint">📍 {{location}}</span>{{/if}}
              {{#if description}}<span class="w-full text-xs whitespace-pre-line text-ink-faint">{{description}}</span>{{/if}}
              {{#if script}}{{#if (isUrl script)}}<a href="{{script}}" target="_blank" rel="noopener noreferrer" class="link text-xs font-normal">📄 Kịch bản</a>{{/if}}{{/if}}
            </li>
          {{/each}}
        </ul>
      </li>
    {{/each}}
  </ul>
{{/if}}
