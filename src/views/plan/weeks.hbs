{{#> page-header title="Plan nội dung" subtitle="Lịch đăng và lịch quay theo tuần — thay cho Google Sheet Plan"}}
  <a href="/plan/new?back={{urlEncode back}}" class="btn-primary">+ Thêm nội dung</a>
{{/page-header}}

{{> plan/tabs}}

<div class="mb-4 flex flex-wrap items-center gap-2">
  <a href="/plan/weeks?month={{prev}}&by={{view}}" class="btn-secondary btn-sm">‹ Tháng trước</a>
  <h2 class="px-2 text-lg font-semibold text-ink">{{monthLabel}}</h2>
  <a href="/plan/weeks?month={{next}}&by={{view}}" class="btn-secondary btn-sm">Tháng sau ›</a>
  {{#if (ne month thisMonth)}}<a href="/plan/weeks?month={{thisMonth}}&by={{view}}" class="btn-ghost btn-sm">Tháng này</a>{{/if}}
  <div class="segmented sm:ml-auto" role="tablist" aria-label="Xếp theo">
    {{#each views}}
      <a href="/plan/weeks?month={{@root.month}}&by={{value}}" role="tab" class="plan-tab {{#if (eq value @root.view)}}plan-tab-active{{/if}}"{{#if (eq value @root.view)}} aria-selected="true"{{/if}}>{{label}}</a>
    {{/each}}
  </div>
</div>

<p class="mb-5 flex flex-wrap gap-2 text-xs" data-plan-summary>
  <span class="badge-blue">📤 {{summary.posts}} bài cần đăng</span>
  <span class="badge-green">✅ {{summary.posted}} đã đăng</span>
  {{#if summary.missingShoot}}<span class="badge-yellow">🎬 {{summary.missingShoot}} chưa có ngày quay</span>{{/if}}
  {{#if summary.overdue}}<span class="badge-red">⏰ {{summary.overdue}} quá ngày đăng chưa đánh dấu Đã đăng</span>{{/if}}
  {{#if summary.conflicts}}<span class="badge-red">⚠ {{summary.conflicts}} trùng giờ quay</span>{{/if}}
</p>

{{#if (eq view 'shoot')}}
  <p class="mb-4 text-xs text-ink-faint">Xếp theo ngày quay → khung giờ → địa điểm. <span class="text-brand-300">Chữ đỏ</span> ở khung giờ = 1 người bị xếp 2 việc cùng giờ ở 2 địa điểm; ở “Quay trước” = quay cách ngày đăng dưới 2 ngày.</p>
{{/if}}

{{#each weeks}}
  <section class="mb-6" data-plan-week>
    <h3 class="mb-2 flex flex-wrap items-baseline gap-2 text-sm font-semibold uppercase tracking-wide {{#if isCurrent}}text-brand-300{{else}}text-ink-soft{{/if}}">
      {{label}} <span class="font-normal normal-case text-ink-faint">· {{range}}</span>
      {{#if isCurrent}}<span class="badge-pink normal-case">Tuần này</span>{{/if}}
    </h3>
    {{#if items.length}}
      <div class="table-wrap">
        <table class="table plan-table">
          <thead>
            {{#if (eq @root.view 'shoot')}}
              <tr><th>Thứ</th><th>Ngày quay</th><th>Khung giờ</th><th>Địa điểm</th><th>Nội dung</th><th>Tham khảo</th><th>Kịch bản</th><th>Phụ trách</th><th>CSVC</th><th>Ngày đăng</th><th>Quay trước</th><th>Trạng thái</th><th>Ghi chú</th></tr>
            {{else}}
              <tr><th>Thứ</th><th>Ngày đăng</th><th>Nội dung</th><th>Brand</th><th>Tham khảo</th><th>Kịch bản</th><th>Phụ trách</th><th>Ngày quay</th><th>Khung giờ</th><th>Địa điểm</th><th>CSVC</th><th>Trạng thái</th><th>Ghi chú</th></tr>
            {{/if}}
          </thead>
          <tbody>
            {{#each items}}
              <tr data-plan-row{{#if overdue}} class="plan-row-overdue"{{/if}}>
                <td class="whitespace-nowrap">{{weekday}}</td>
                {{#if (eq @root.view 'shoot')}}
                  <td class="whitespace-nowrap tabular-nums">{{formatDay shoot_date}}</td>
                  <td class="whitespace-nowrap{{#if conflict}} font-semibold text-brand-300{{/if}}"{{#if conflict}} title="Người phụ trách bị xếp quay cùng giờ ở địa điểm khác"{{/if}}>{{#if conflict}}⚠ {{/if}}{{shoot_time}}</td>
                  <td class="whitespace-nowrap">{{location}}</td>
                  <td>{{> plan/title-cell}}</td>
                  <td>{{> plan/link-or-text value=reference_url label="Xem"}}</td>
                  <td>{{> plan/link-or-text value=script label="Mở"}}</td>
                  <td class="whitespace-nowrap">{{owner_name}}</td>
                  <td>{{props}}</td>
                  <td class="whitespace-nowrap tabular-nums">{{#if post_date}}{{formatDay post_date}}{{else}}<span class="text-ink-faint">Chưa chốt</span>{{/if}}</td>
                  <td class="text-center tabular-nums{{#if shootTight}} font-semibold text-brand-300{{/if}}">{{leadDays}}</td>
                {{else}}
                  <td class="whitespace-nowrap tabular-nums">{{formatDay post_date}}{{#if post_time}} <span class="text-ink-faint">{{post_time}}</span>{{/if}}</td>
                  <td>{{> plan/title-cell}}</td>
                  <td class="whitespace-nowrap">{{brand}}</td>
                  <td>{{> plan/link-or-text value=reference_url label="Xem"}}</td>
                  <td>{{> plan/link-or-text value=script label="Mở"}}</td>
                  <td class="whitespace-nowrap">{{owner_name}}</td>
                  <td class="whitespace-nowrap tabular-nums">
                    {{#if shoot_date}}<span{{#if shootTight}} class="font-semibold text-brand-300" title="Quay cách ngày đăng dưới 2 ngày"{{/if}}>{{formatDay shoot_date}}</span>
                    {{else if missingShoot}}<span class="text-sun-300">Chưa có</span>{{/if}}
                  </td>
                  <td class="whitespace-nowrap{{#if conflict}} font-semibold text-brand-300{{/if}}">{{#if conflict}}⚠ {{/if}}{{shoot_time}}</td>
                  <td class="whitespace-nowrap">{{location}}</td>
                  <td>{{props}}</td>
                {{/if}}
                <td class="whitespace-nowrap">
                  <span class="{{statusInfo.badge}}">{{statusInfo.label}}</span>
                  {{#if overdue}}<span class="mt-1 block text-[11px] text-brand-300">⏰ Quá ngày đăng</span>{{/if}}
                </td>
                <td><span class="plan-cell-text" title="{{note}}">{{note}}</span></td>
              </tr>
            {{/each}}
          </tbody>
        </table>
      </div>
    {{else}}
      <p class="rounded-xl border border-dashed border-line px-4 py-3 text-sm text-ink-faint">Chưa có nội dung {{#if (eq @root.view 'shoot')}}quay{{else}}đăng{{/if}} trong tuần này.</p>
    {{/if}}
  </section>
{{/each}}

{{#if (eq view 'shoot')}}
  <h2 class="mt-8 mb-3 text-lg font-semibold text-ink">Chưa có ngày quay <span class="text-sm font-normal text-ink-faint">(video sắp đăng)</span></h2>
  {{#if unshot.length}}
    <ul class="card divide-y divide-line" data-plan-unshot>
      {{#each unshot}}
        <li class="flex flex-wrap items-center gap-2 px-4 py-3 text-sm">
          <span class="w-24 shrink-0 tabular-nums text-ink-soft">📤 {{formatDay post_date}}</span>
          {{> plan/title-cell}}
          {{#if owner_name}}<span class="text-xs text-ink-faint">👤 {{owner_name}}</span>{{/if}}
          {{#if location}}<span class="text-xs text-ink-faint">📍 {{location}}</span>{{/if}}
          {{#if canEdit}}<a href="/plan/{{id}}/edit?back={{urlEncode @root.back}}" class="btn-ghost btn-sm ml-auto">🎬 Chốt ngày quay</a>{{/if}}
        </li>
      {{/each}}
    </ul>
  {{else}}
    <p class="text-sm text-ink-faint">Không có — mọi video sắp đăng đều đã có ngày quay. 👍</p>
  {{/if}}
{{/if}}

{{#if canImport}}
  <div class="card card-body mt-10 flex flex-col gap-3 sm:flex-row sm:items-center">
    <div class="min-w-0 flex-1">
      <p class="font-medium text-ink">Chuyển dữ liệu từ Google Sheet cũ</p>
      <p class="text-sm text-ink-faint">Nhập các dòng ở tab Plan và Idea bank của Sheet “Idea bank - Gốm Vũ Gia, Klayy &amp; GSXD” vào app. Bấm lại cũng không bị trùng. Chỉ quản lý thấy nút này.</p>
    </div>
    <form method="post" action="/plan/import-sheet" data-confirm="Nhập dữ liệu từ Google Sheet cũ vào Plan?">
      {{> form/csrf}}
      <button type="submit" class="btn-secondary whitespace-nowrap">⬇ Nhập từ Sheet</button>
    </form>
  </div>
{{/if}}
