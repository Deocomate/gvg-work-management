{{#> page-header title=text.title subtitle=text.subtitle}}
  <a href="/plan/new?back={{urlEncode back}}" class="btn-primary">+ Thêm nội dung</a>
{{/page-header}}

{{> plan/tabs}}

<div class="mb-3 flex flex-wrap items-center gap-2">
  <a href="/plan/weeks?kind={{kind}}{{#if brand}}&brand={{urlEncode brand}}{{/if}}&week={{prev}}" class="btn-secondary btn-sm" aria-label="Tuần trước">‹</a>
  <h2 class="px-1 text-lg font-semibold text-ink">{{label}} <span class="text-sm font-normal text-ink-faint">· {{range}}</span></h2>
  <a href="/plan/weeks?kind={{kind}}{{#if brand}}&brand={{urlEncode brand}}{{/if}}&week={{next}}" class="btn-secondary btn-sm" aria-label="Tuần sau">›</a>
  {{#if (ne week thisWeek)}}<a href="/plan/weeks?kind={{kind}}{{#if brand}}&brand={{urlEncode brand}}{{/if}}" class="btn-ghost btn-sm">Tuần này</a>{{/if}}
</div>

<p class="mb-4 flex flex-wrap gap-2 text-xs" data-plan-summary>
  <span class="{{#if (eq kind 'shoot')}}badge-yellow{{else}}badge-blue{{/if}}">{{text.icon}} {{summary.total}} {{text.unit}}</span>
  <span class="badge-green">✅ {{summary.done}} {{text.done}}</span>
  {{#if (eq kind 'post')}}
    {{#if summary.missingShoot}}<span class="badge-orange">❗ {{summary.missingShoot}} chưa có ngày quay</span>{{/if}}
  {{else}}
    {{#if summary.conflicts}}<span class="badge-red">⚠ {{summary.conflicts}} trùng giờ quay</span>{{/if}}
    {{#if summary.tight}}<span class="badge-orange">⏱ {{summary.tight}} quay sát ngày đăng</span>{{/if}}
  {{/if}}
</p>

{{!-- Mỗi brand một hàng riêng, 7 ngày. Máy tính: 7 cột; điện thoại: chỉ hiện ngày có nội dung --}}
<div class="space-y-4" data-plan-week>
  {{#if groups.length}}
    <div class="plan-week-head" aria-hidden="true">
      {{#each weekdays}}<div class="{{#if isToday}}text-brand-300{{/if}}"><span class="font-semibold">{{weekday}}</span> {{dayMonth}}</div>{{/each}}
    </div>
  {{/if}}
  {{#each groups}}
    <section class="plan-lane" data-plan-brand="{{label}}">
      <h3 class="plan-lane-head"><span class="{{badge}}">{{label}}</span> <span class="text-xs font-normal text-ink-faint">{{total}} {{@root.text.unit}}</span></h3>
      <div class="plan-week">
        {{#each days}}
          <div class="plan-day{{#if isToday}} plan-day-today{{/if}}{{#if isPast}} plan-day-past{{/if}}{{#unless entries.length}} plan-day-empty{{/unless}}" data-plan-day="{{date}}">
            <div class="plan-day-head">
              <span class="lg:hidden"><span class="font-semibold">{{weekday}}</span> <span class="text-ink-faint">{{dayMonth}}</span></span>
              <a href="/plan/new?{{@root.text.dateParam}}={{date}}{{#if ../value}}&brand={{urlEncode ../value}}{{/if}}&back={{urlEncode @root.back}}" class="plan-day-add lg:ml-auto" title="Thêm nội dung {{../label}} ngày {{dayMonth}}" aria-label="Thêm nội dung {{../label}} ngày {{dayMonth}}">+</a>
            </div>
            <ul class="space-y-1.5">
              {{#each entries}}
                <li class="plan-entry {{statusInfo.chip}}" data-plan-row>
                  {{!-- Lịch quay: dòng khung giờ + cảnh báo. Lịch đăng: không ghi giờ, chỉ hiện cảnh báo nếu có --}}
                  {{#if (eq kind 'shoot')}}
                    <p class="flex items-center gap-1 text-[11px] font-semibold">
                      {{#if time}}<span class="tabular-nums">{{time}}</span>{{else}}<span class="opacity-70">Chưa có giờ</span>{{/if}}
                      {{#if conflict}}<span title="Người phụ trách bị xếp quay cùng giờ ở địa điểm khác">⚠</span>{{/if}}
                      {{#if shootTight}}<span title="Quay cách ngày đăng dưới 2 ngày">⏱</span>{{/if}}
                    </p>
                  {{else if (or missingShoot shootTight)}}
                    <p class="flex items-center gap-1 text-[11px] font-semibold">
                      {{#if missingShoot}}<span title="Chưa có ngày quay">❗ Chưa có ngày quay</span>{{/if}}
                      {{#if shootTight}}<span title="Quay cách ngày đăng dưới 2 ngày">⏱ Quay sát ngày</span>{{/if}}
                    </p>
                  {{/if}}
                  {{#if canEdit}}
                    <a href="/plan/{{id}}/edit?back={{urlEncode @root.back}}" class="plan-entry-title hover:underline" title="{{title}}">{{title}}</a>
                  {{else}}
                    <span class="plan-entry-title" title="{{title}}">{{title}}</span>
                  {{/if}}
                  {{#if (and (eq kind 'shoot') location)}}<p class="mt-0.5 truncate text-[11px] opacity-80">📍 {{location}}</p>{{/if}}
                  {{> plan/script-summary}}
                </li>
              {{/each}}
            </ul>
          </div>
        {{/each}}
      </div>
    </section>
  {{else}}
    <p class="rounded-xl border border-dashed border-line px-4 py-6 text-center text-sm text-ink-faint" data-plan-empty>Tuần này chưa có {{text.unit}} nào.</p>
  {{/each}}
</div>

<p class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-xs text-ink-faint">
  {{#if (eq kind 'post')}}<span>❗ Chưa có ngày quay</span>{{else}}<span>⚠ Trùng giờ quay</span>{{/if}}
  <span>⏱ Quay sát ngày đăng (&lt; 2 ngày)</span>
  <span>Màu thẻ = bước hiện tại. Nội dung có người phụ trách tự hiện ở “Hôm nay” / “Tháng” của người đó.</span>
</p>

{{#if unshot.length}}
  <h2 class="mt-8 mb-3 text-lg font-semibold text-ink">Cần chốt ngày quay <span class="text-sm font-normal text-ink-faint">(sắp đăng mà chưa có ngày quay)</span></h2>
  <ul class="card divide-y divide-line" data-plan-unshot>
    {{#each unshot}}
      <li class="flex flex-wrap items-center gap-2 px-4 py-3 text-sm">
        <span class="w-28 shrink-0 tabular-nums text-ink-soft">📤 {{formatDay post_date}}</span>
        <span class="{{brandInfo.badge}}">{{brandInfo.label}}</span>
        <span class="min-w-0 flex-1 truncate font-medium text-ink" title="{{title}}">{{title}}</span>
        {{#if canEdit}}<a href="/plan/{{id}}/edit?back={{urlEncode @root.back}}" class="btn-ghost btn-sm">🎬 Chốt ngày quay</a>{{/if}}
      </li>
    {{/each}}
  </ul>
{{/if}}
