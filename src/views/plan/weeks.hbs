{{#> page-header title="Plan nội dung" subtitle="Lịch quay và đăng bài — tự lên lịch làm việc của người phụ trách"}}
  <a href="/plan/new?back={{urlEncode back}}" class="btn-primary">+ Thêm nội dung</a>
{{/page-header}}

{{> plan/tabs}}

<div class="mb-3 flex flex-wrap items-center gap-2">
  <a href="/plan/weeks?week={{prev}}" class="btn-secondary btn-sm" aria-label="Tuần trước">‹</a>
  <h2 class="px-1 text-lg font-semibold text-ink">{{label}} <span class="text-sm font-normal text-ink-faint">· {{range}}</span></h2>
  <a href="/plan/weeks?week={{next}}" class="btn-secondary btn-sm" aria-label="Tuần sau">›</a>
  {{#if (ne week thisWeek)}}<a href="/plan/weeks" class="btn-ghost btn-sm">Tuần này</a>{{/if}}
</div>

<p class="mb-4 flex flex-wrap gap-2 text-xs" data-plan-summary>
  <span class="badge-yellow">🎬 {{summary.shoots}} buổi quay</span>
  <span class="badge-blue">📤 {{summary.posts}} bài cần đăng</span>
  <span class="badge-green">✅ {{summary.posted}} đã đăng</span>
  {{#if summary.missingShoot}}<span class="badge-orange">❗ {{summary.missingShoot}} chưa có ngày quay</span>{{/if}}
  {{#if summary.overdue}}<span class="badge-red">⏰ {{summary.overdue}} quá ngày đăng</span>{{/if}}
  {{#if summary.conflicts}}<span class="badge-red">⚠ {{summary.conflicts}} trùng giờ quay</span>{{/if}}
</p>

{{!-- 7 ngày: máy tính 7 cột, điện thoại xếp dọc --}}
<div class="plan-week" data-plan-week>
  {{#each days}}
    <section class="plan-day{{#if isToday}} plan-day-today{{/if}}{{#if isPast}} plan-day-past{{/if}}" data-plan-day="{{date}}">
      <div class="plan-day-head">
        <span><span class="font-semibold">{{weekday}}</span> <span class="text-ink-faint">{{dayMonth}}</span></span>
        <a href="/plan/new?post_date={{date}}&back={{urlEncode @root.back}}" class="plan-day-add" title="Thêm nội dung đăng ngày {{dayMonth}}" aria-label="Thêm nội dung đăng ngày {{dayMonth}}">+</a>
      </div>
      <ul class="space-y-1.5">
        {{#each entries}}
          <li class="plan-entry {{statusInfo.chip}}" data-plan-row>
            <p class="flex items-center gap-1 text-[11px] font-semibold">
              <span aria-hidden="true">{{#if (eq kind 'shoot')}}🎬{{else}}📤{{/if}}</span>
              <span>{{#if (eq kind 'shoot')}}Quay{{else}}Đăng{{/if}}{{#if time}} {{time}}{{/if}}</span>
              {{#if (and (eq kind 'shoot') conflict)}}<span title="Người phụ trách bị xếp quay cùng giờ ở địa điểm khác">⚠</span>{{/if}}
              {{#if (and (eq kind 'post') overdue)}}<span title="Quá ngày đăng mà chưa đánh dấu Đã đăng">⏰</span>{{/if}}
              {{#if (and (eq kind 'post') missingShoot)}}<span title="Chưa có ngày quay">❗</span>{{/if}}
              {{#if shootTight}}<span title="Quay cách ngày đăng dưới 2 ngày">⏱</span>{{/if}}
            </p>
            {{#if canEdit}}
              <a href="/plan/{{id}}/edit?back={{urlEncode @root.back}}" class="plan-entry-title hover:underline" title="{{title}}">{{title}}</a>
            {{else}}
              <span class="plan-entry-title" title="{{title}}">{{title}}</span>
            {{/if}}
            <p class="mt-0.5 truncate text-[11px] opacity-80">
              {{#if (and (eq kind 'shoot') location)}}📍 {{location}} · {{/if}}{{#if brand}}{{brand}} · {{/if}}{{#if owner_name}}{{owner_name}}{{else}}Chưa giao{{/if}}
            </p>
          </li>
        {{else}}
          <li class="hidden text-xs text-ink-faint lg:block">—</li>
        {{/each}}
      </ul>
    </section>
  {{/each}}
</div>

<p class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-xs text-ink-faint">
  <span>🎬 Buổi quay</span><span>📤 Bài đăng</span><span>❗ Chưa có ngày quay</span><span>⏱ Quay sát ngày đăng (&lt; 2 ngày)</span><span>⚠ Trùng giờ quay</span><span>⏰ Quá ngày đăng</span>
  <span>Màu thẻ = trạng thái. Nội dung có người phụ trách tự hiện ở “Hôm nay” / “Tháng” của người đó.</span>
</p>

{{#if unshot.length}}
  <h2 class="mt-8 mb-3 text-lg font-semibold text-ink">Cần chốt ngày quay <span class="text-sm font-normal text-ink-faint">(sắp đăng mà chưa có ngày quay)</span></h2>
  <ul class="card divide-y divide-line" data-plan-unshot>
    {{#each unshot}}
      <li class="flex flex-wrap items-center gap-2 px-4 py-3 text-sm">
        <span class="w-28 shrink-0 tabular-nums text-ink-soft">📤 {{formatDay post_date}}</span>
        <span class="min-w-0 flex-1 truncate font-medium text-ink" title="{{title}}">{{title}}</span>
        {{#if owner_name}}<span class="text-xs text-ink-faint">👤 {{owner_name}}</span>{{/if}}
        {{#if canEdit}}<a href="/plan/{{id}}/edit?back={{urlEncode @root.back}}" class="btn-ghost btn-sm">🎬 Chốt ngày quay</a>{{/if}}
      </li>
    {{/each}}
  </ul>
{{/if}}
