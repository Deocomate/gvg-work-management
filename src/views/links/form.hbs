{{#> page-header title=title}}
  <a href="/links" class="btn-secondary">← Danh sách</a>
{{/page-header}}

<form method="post" action="{{#if link}}/links/{{link.id}}{{else}}/links{{/if}}" class="card card-body max-w-2xl space-y-5" novalidate>
  {{> form/csrf}}
  {{#if errors._form}}<div class="alert-error">{{errors._form}}</div>{{/if}}

  {{> form/field name="title" label="Tên tài liệu" value=values.title error=errors.title required=true placeholder="VD: Quy trình nghỉ phép"}}
  {{> form/field name="url" label="Đường link" type="url" value=values.url error=errors.url required=true placeholder="https://drive.google.com/..." hint="Link Google Drive, Docs, Sheets, Slides, Forms, YouTube sẽ có nút “Xem trước” ngay trong app."}}
  {{!-- Chọn thư mục có sẵn, hoặc "+ Tạo thư mục mới…" -> hiện ô nhập tên (data-show-when, pickers.js) --}}
  {{> form/select name="folder_id" label="Thư mục" options=folderOptions value=values.folder_id error=errors.folder_id placeholder="Chưa phân loại"}}
  <div data-show-when="folder_id=new">
    {{> form/field name="new_folder" label="Tên thư mục mới" value=values.new_folder error=errors.new_folder placeholder="VD: Biểu mẫu, Quy trình, Hợp đồng" hint="Thư mục được tạo cùng lúc với link. Trùng tên thư mục đã có thì link vào thư mục đó."}}
  </div>
  {{> form/textarea name="note" label="Ghi chú" value=values.note error=errors.note rows=2 hint="Không bắt buộc. VD: dùng khi nào, ai phụ trách"}}

  <div class="flex gap-2 pt-2">
    <button type="submit" class="btn-primary">{{#if link}}Lưu thay đổi{{else}}Thêm link{{/if}}</button>
    <a href="/links" class="btn-ghost">Huỷ</a>
  </div>
</form>
