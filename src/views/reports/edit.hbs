{{#> page-header title="Nhập báo cáo tuần" subtitle=(concat "Tuần " label " · số nội dung, quảng cáo, khách hàng tự lấy — chỉ cần nhập phần dưới")}}
  <a href="/reports?date={{from}}" class="btn-ghost btn-sm">‹ Về báo cáo</a>
{{/page-header}}

<form method="post" action="/reports" novalidate>
  {{> form/csrf}}
  <input type="hidden" name="date" value="{{from}}">

  <section id="social" class="card card-body mb-6" aria-labelledby="e-social">
    <h2 id="e-social" class="text-lg font-semibold text-ink">Chỉ số kênh mạng xã hội</h2>
    <p class="mt-1 mb-4 text-sm text-ink-faint">
      {{#if socialConnected}}Ô viền xanh = số tự lấy từ Facebook / Instagram / TikTok / YouTube (follower chỉ lấy cho tuần đang diễn ra) — sửa được, bấm Lưu để chốt số.
      Kênh chưa kết nối thì xem trong TikTok Studio / Meta Business Suite / YouTube Studio rồi điền.
      {{else}}Chưa kết nối tài khoản mạng xã hội nên cần nhập tay: xem trong TikTok Studio / Meta Business Suite / YouTube Studio rồi điền.
      Muốn tự lấy số, người quản trị máy chủ thêm SOCIAL_ACCOUNTS và token (xem .env.example).{{/if}}
      Kênh không dùng thì để trống. Follower nhập tổng cuối tuần — báo cáo tự tính số tăng so với tuần trước.
    </p>
    <div class="grid gap-6 xl:grid-cols-3">
      {{#each brands}}
        <div>
          <h3 class="mb-2"><span class="{{badge}}">{{label}}</span></h3>
          <div class="table-wrap">
            <table class="table">
              <thead><tr><th>Kênh</th>{{#each @root.metrics}}<th class="text-right">{{label}}</th>{{/each}}</tr></thead>
              <tbody>
                {{#each rows}}
                  <tr>
                    <td class="whitespace-nowrap">{{label}}</td>
                    {{#each cells}}
                      <td class="min-w-24">
                        <input type="text" inputmode="numeric" name="{{name}}" value="{{value}}" aria-label="{{label}}"
                          class="input py-1 text-right tabular-nums{{#if error}} input-error{{/if}}{{#if auto}} ring-1 ring-ok-400/60{{/if}}"{{#if error}} aria-invalid="true" title="{{error}}"{{else if auto}} title="Tự lấy từ nền tảng — sửa được"{{/if}}>
                        {{#if error}}<p class="field-error">{{error}}</p>{{/if}}
                      </td>
                    {{/each}}
                  </tr>
                {{/each}}
              </tbody>
            </table>
          </div>
        </div>
      {{/each}}
    </div>
  </section>

  <section id="ads" class="card card-body mb-6" aria-labelledby="e-ads">
    <h2 id="e-ads" class="text-lg font-semibold text-ink">Quảng cáo (nhập tay)</h2>
    <p class="mt-1 mb-4 text-sm text-ink-faint">
      Chỉ cần điền khi báo cáo không tự lấy được số (token hết hạn, chưa kết nối). Xem trong Trình quản lý quảng cáo / TikTok Ads Manager, chọn đúng ngày của tuần rồi điền.
      Nền tảng nào có số ở đây thì báo cáo dùng số này thay cho số tự lấy. Để trống hết = dùng số tự lấy.
    </p>
    <div class="table-wrap">
      <table class="table">
        <thead><tr><th>Nền tảng</th>{{#each adMetrics}}<th class="text-right">{{label}}</th>{{/each}}</tr></thead>
        <tbody>
          {{#each adRows}}
            <tr>
              <td class="whitespace-nowrap">{{label}}</td>
              {{#each cells}}
                <td class="min-w-28">
                  <input type="text" inputmode="numeric" name="{{name}}" value="{{value}}" aria-label="{{label}}"
                    class="input py-1 text-right tabular-nums{{#if error}} input-error{{/if}}"{{#if error}} aria-invalid="true" title="{{error}}"{{/if}}>
                  {{#if error}}<p class="field-error">{{error}}</p>{{/if}}
                </td>
              {{/each}}
            </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
  </section>

  <section id="notes" class="card card-body mb-6" aria-labelledby="e-notes">
    <h2 id="e-notes" class="mb-4 text-lg font-semibold text-ink">Nhận xét</h2>
    <div class="grid gap-4 md:grid-cols-2">
      {{> form/textarea name="highlights" label="Điểm nổi bật" value=values.highlights error=errors.highlights rows=5 placeholder="VD: Video bình hoa Vũ Gia đạt 120k view, inbox tăng mạnh"}}
      {{> form/textarea name="issues" label="Vấn đề gặp phải" value=values.issues error=errors.issues rows=5 placeholder="VD: Trễ 2 buổi quay GSXD do thời tiết"}}
    </div>
  </section>

  {{#if prevPlanItems.length}}
    {{!-- Kế hoạch đã đề ra ở báo cáo tuần trước: tick việc đã xong --}}
    <section id="prev-plan" class="card card-body mb-6" aria-labelledby="e-prev-plan">
      <input type="hidden" name="prev_plan_shown" value="1">
      <h2 id="e-prev-plan" class="text-lg font-semibold text-ink">Kế hoạch tuần này</h2>
      <p class="mt-1 mb-3 text-sm text-ink-faint">Đã đề ra ở báo cáo tuần trước. Việc lấy từ Lịch làm việc tự đánh dấu Xong; việc gõ tay thì tick ở đây.</p>
      <ul class="space-y-2">
        {{#each prevPlanItems}}
          <li>
            <label class="flex items-start gap-3 text-sm">
              {{#if auto}}
                <input type="checkbox" class="mt-1" {{checked done}} disabled aria-label="Tự theo Lịch làm việc">
              {{else}}
                <input type="checkbox" name="prev_plan_done" value="{{id}}" class="mt-1" {{checked done}}>
              {{/if}}
              <span><span class="text-ink">{{title}}</span>
                <span class="text-xs text-ink-faint">{{#if target}} · {{target}}{{/if}}{{#if owner_name}} · {{owner_name}}{{/if}}{{#if due_date}} · hạn {{formatDay due_date}}{{/if}}{{#if auto}} · tự theo Lịch làm việc{{#if progress}} ({{progress}} ngày xong){{/if}}{{/if}}</span></span>
            </label>
          </li>
        {{/each}}
      </ul>
    </section>
  {{/if}}

  <section id="plan" class="card card-body mb-6" aria-labelledby="e-plan">
    <h2 id="e-plan" class="text-lg font-semibold text-ink">Kế hoạch tuần tới <span class="text-sm font-normal text-ink-faint">{{nextLabel}}</span></h2>
    <p class="mt-1 mb-4 text-sm text-ink-faint">
      {{#if planFromCalendar}}Đã điền sẵn các việc giao tuần tới trên Lịch làm việc — sửa, thêm mục tiêu hoặc bỏ bớt rồi bấm Lưu.{{else}}Mỗi dòng một việc. Dòng để trống thì bỏ qua.{{/if}}
      Báo cáo tuần sau hiện lại danh sách này để xem đã xong chưa.
    </p>
    <div data-row-list data-max="30">
      <div class="space-y-2" data-rows>
        {{#each planRows}}{{> reports/plan-row row=this ownerOptions=@root.ownerOptions brandOptions=@root.brandOptions min=@root.nextWeek.from max=@root.nextWeek.to}}{{/each}}
      </div>
      <template data-row-template>{{> reports/plan-row ownerOptions=ownerOptions brandOptions=brandOptions min=nextWeek.from max=nextWeek.to}}</template>
      <div class="mt-2 flex flex-wrap gap-2">
        <button type="button" class="btn-ghost btn-sm" data-row-add>+ Thêm việc</button>
        <a href="/reports/edit?date={{from}}&add=calendar#plan" class="btn-ghost btn-sm" title="Thêm các việc đã giao tuần tới trên Lịch làm việc mà kế hoạch chưa có">+ Lấy thêm từ Lịch làm việc</a>
      </div>
    </div>
    <div class="mt-4">
      {{> form/textarea name="next_plan" label="Ghi chú thêm" value=values.next_plan error=errors.next_plan rows=3 placeholder="VD: Ưu tiên video Klayy cho đợt sale 12/12"}}
    </div>
  </section>

  <div class="flex gap-2">
    <button type="submit" class="btn-primary">Lưu báo cáo</button>
    <a href="/reports?date={{from}}" class="btn-ghost">Huỷ</a>
  </div>
</form>
