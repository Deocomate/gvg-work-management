<!doctype html>
<html lang="vi">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{#if title}}{{title}} · {{/if}}{{appName}}</title>
  <meta name="csrf-token" content="{{csrfToken}}">
  <link rel="icon" href="/img/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/css/app.css">
  <script src="/js/app.js" defer></script>
</head>
<body class="flex min-h-screen flex-col bg-slate-50 font-sans text-slate-800 antialiased">
  {{> nav}}

  <main class="container-page flex-1 py-8">
    {{> flash}}
    {{{body}}}
  </main>

  <footer class="border-t border-slate-200 bg-white py-4 text-center text-xs text-slate-500">
    © {{year}} {{appName}}
  </footer>
</body>
</html>
