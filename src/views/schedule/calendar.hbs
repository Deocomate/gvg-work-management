{{!-- Trang Chấm công: bảng công tháng (mỗi nhân viên một tab), bấm một ngày để chấm công / nhập giờ --}}
{{#> page-header title=monthLabel subtitle=subtitle}}{{/page-header}}

<div class="toolbar mb-5">
  <a href="/calendar?month={{prev}}" class="btn-secondary btn-sm">‹ Tháng trước</a>
  {{#if (ne month thisMonth)}}<a href="/calendar?month={{thisMonth}}" class="btn-ghost btn-sm">Tháng này</a>{{/if}}
  <a href="/calendar?month={{next}}" class="btn-secondary btn-sm">Tháng sau ›</a>
</div>

{{#if payrollEnabled}}
  {{> payroll-attendance month=month day=today focus=attFocus}}
{{else}}
  {{> empty-state title="Chưa bật phần Chấm công & Lương" text="Quản trị cần cấu hình phần Lương trước khi chấm công."}}
{{/if}}
